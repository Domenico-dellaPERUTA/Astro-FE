---
import helloAudioSrc from "../../assets/WebPages/Rust/hello_word.mp3";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FlexibleLayout from "../../components/UI/FlexibleLayout.vue";
import { buildMenuTree, findSiblings } from "../../utils/buildMenuTree";
// Pipeline condivisa con TopicPage.vue: l'HTML statico dell'underlay
// è identico a quello che l'app Vue genera nel browser
import { renderMarkdown, cleanCode, escapeHtml, sanitizePageHtml } from "../../utils/renderMarkdown";

export async function getStaticPaths() {
  const topicsInfo = await getCollection("topics");
  const menuTree = buildMenuTree(topicsInfo);

  const paths = [];

  for (const topic of topicsInfo) {
    // Le bozze (visible: false) non generano nemmeno la pagina:
    // né nel menu, né tra i siblings, né via URL diretto (404)
    if (topic.data.visible === false) continue;

    const siblings = findSiblings(topicsInfo, topic.data.menu);

    if (topic.data.type === "dictionary" && topic.data.dictionary) {
      // Pagina base del dizionario (ora l'unica)
      paths.push({
        params: { slug: topic.id },
        props: {
          topic,
          menuTree,
          siblings, // I siblings normali (altri topic nel menu)
          currentIndex: 0,
        },
      });
    } else {
      paths.push({
        params: { slug: topic.id },
        props: { topic, menuTree, siblings, currentIndex: 0 },
      });
    }
  }

  return paths;
}

const { topic, menuTree, siblings, currentIndex, virtualTitle } = Astro.props;

// --- 🌉 Asset Resolution Bridge ---
const allAssets = import.meta.glob(
  "/src/assets/WebPages/**/*.{png,jpg,jpeg,gif,svg,mp3}",
  { eager: true },
);

function resolveAsset(legacyPath: string) {
  if (!legacyPath) return "";

  const cleanPath = legacyPath.startsWith("/")
    ? legacyPath.slice(1)
    : legacyPath;
  const fullPath = `/src/assets/${cleanPath}`;

  const asset = allAssets[fullPath];
  if (asset) {
    const mod = (asset as any).default;
    return typeof mod === "object" ? mod.src : mod;
  }
  return legacyPath;
}

// Audio resolve - use pre-imported audio files or dynamic resolution
function resolveAudio(legacyPath: string) {
  if (!legacyPath) return "";

  // Try dynamic resolution first
  const resolved = resolveAsset(legacyPath);
  if (resolved !== legacyPath) return resolved;

  // Fallback for specific files or external links
  if (!/\.(mp3|wav|ogg)$/i.test(legacyPath)) return legacyPath;

  if (legacyPath.includes("hello_word")) {
    return helloAudioSrc;
  }

  return legacyPath;
}

// ♟️ Audio delle pagine chess: le clip sono file `<chiave>.mp3` in
// src/assets/WebPages/Chess/ (chiave = sequenza SAN senza glifi, uniti da "_").
// allAssets (glob sopra) copre già la cartella; qui costruiamo la mappa
// chiave → URL risolta da Vite (/_astro/...mp3) e la passiamo nel pageData:
// il client non può ricostruire un URL hashato, quindi il bridge build-time è
// indispensabile. Clip assente → chiave non presente → silenzio, zero richieste.
// ⚠️ Dopo ogni aggiunta/rimozione di clip serve `npm run build`.
const chessAudio: Record<string, string> = {};
if (topic.data.type === "chess") {
  for (const [assetPath, asset] of Object.entries(allAssets)) {
    const m = /^\/src\/assets\/WebPages\/Chess\/(.+)\.mp3$/.exec(assetPath);
    if (!m) continue;
    const mod = (asset as any).default;
    const url = typeof mod === "object" && mod !== null ? mod.src : mod;
    if (typeof url === "string") chessAudio[m[1]] = url;
  }
}

// 1. Risolviamo gli asset nel corpo del testo
let resolvedBody = topic.body || "";

// per i file .md -> ![alt](/WebPages/...)
resolvedBody = resolvedBody.replace(
  /!\[([^\]]*)\]\((\/WebPages\/[^)]+)\)/g,
  (match, alt, path) => {
    const resolved = resolveAsset(path);
    return `![${alt}](${resolved})`;
  },
);

// per i file html src="..." o href="..." (e data-audio per il tipo "steps")
resolvedBody = resolvedBody.replace(
  /(src|href|data-audio)="(\/WebPages\/[^"]+)"/g,
  (match, attr, path) => {
    return `${attr}="${resolveAsset(path)}"`;
  },
);

// 2. Risolviamo gli asset nelle immagini del carosello o nel dizionario
let resolvedItems = [];
// Slide YAML del tipo "steps" (con gli asset risolti)
let resolvedSlides: any[] = [];
if (topic.data.type === "carousel") {
  resolvedItems = (topic.data.images || []).map((img) => {
    // Supporta sia stringhe semplici che oggetti con image, title, text
    const imgPath = typeof img === "object" ? img.image : img;
    const imgTitle = typeof img === "object" ? img.title : undefined;
    const imgText = typeof img === "object" ? img.text : undefined;

    // Risolviamo l'immagine
    const resolvedImg = resolveAsset(imgPath);
    // Risolviamo l'audio corrispondente (sostituendo l'estensione nel path originale)
    const audioPath = String(imgPath).replace(/\.(png|jpg|jpeg)$/i, ".mp3");
    const resolvedAud = resolveAudio(audioPath);
    return {
      image: resolvedImg,
      audio: resolvedAud,
      title: imgTitle,
      text: imgText,
      originalPath: imgPath, // teniamolo per compatibilità o debug
    };
  });
} else if (topic.data.type === "video") {
  resolvedItems = (topic.data.videos || []).map((vid) => {
    const vidUrl = typeof vid === "object" ? vid.url : vid;
    const vidTitle = typeof vid === "object" ? vid.title : undefined;
    const vidText = typeof vid === "object" ? vid.text : undefined;
    return {
      url: vidUrl,
      title: vidTitle,
      text: vidText,
    };
  });
} else if (topic.data.type === "dictionary" && topic.data.dictionary) {
    // Risolviamo gli asset per tutti gli elementi del dizionario
    resolvedItems = topic.data.dictionary.map((item) => {
      const path = item.path || "";
      return {
        ...item,
        // Aggiungiamo campi risolti che TopicPage.vue possa usare
        resolvedImageJpg: resolveAsset(`${path}${item.item}.jpg`),
        resolvedImagePng: resolveAsset(`${path}${item.item}.png`),
        resolvedAudio: resolveAudio(`${path}${item.item}.mp3`),
      };
    });
  } else if (topic.data.type === "steps" && topic.data.slides) {
    // Risolviamo gli asset nelle slide YAML del tipo "steps":
    // mp3 dei passi e delle slide + src/href/data-audio dentro i blocchi html
    resolvedSlides = topic.data.slides.map((slide) => ({
      ...slide,
      audio: slide.audio ? resolveAudio(slide.audio) : undefined,
      steps: (slide.steps || []).map((step) => ({
        ...step,
        audio: step.audio ? resolveAudio(step.audio) : undefined,
        html: step.html
          ? step.html.replace(
              /(src|href|data-audio)="(\/WebPages\/[^"]+)"/g,
              (match, attr, path) => `${attr}="${resolveAsset(path)}"`,
            )
          : undefined,
      })),
    }));
  }

// 3. Risolviamo l'audio
// Supporta sia `audio: "/path/file.mp3"` che `audio: true` (abilita pulsante + TTS fallback)
const rawAudio = topic.data.audio;
let resolvedAudio: string | boolean = "";
if (typeof rawAudio === "boolean") {
  resolvedAudio = rawAudio;
} else if (typeof rawAudio === "string" && rawAudio) {
  resolvedAudio = resolveAudio(rawAudio);
}

// --- 🔎 SEO: description + dati strutturati ---
/** Description per i motori di ricerca: dal frontmatter o dedotta dal contenuto */
function deriveDescription(data: any, body: string): string {
  if (data.description) return data.description;

  // Tipo "md": primi ~160 caratteri di testo pulito
  if (data.type === "md") {
    const text = body
      .replace(/```[\s\S]*?```/g, " ")          // blocchi di codice
      .replace(/`[^`\n]*`/g, " ")               // codice inline
      .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")    // immagini
      .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")  // link → testo
      .replace(/\$\$?[^$\n]*\$\$?/g, " ")       // formule KaTeX
      .replace(/<[^>]+>/g, " ")                 // tag HTML
      .replace(/[#>*_~|]+/g, " ")               // sintassi markdown
      .replace(/\s+/g, " ")
      .trim();
    if (text.length > 40) {
      const cut = text.slice(0, 157);
      return `${cut.slice(0, cut.lastIndexOf(" ")).trim() || cut}…`;
    }
  }

  // Fallback generico: titolo + sezione del menu (senza emoji)
  const sezione = String(data.menu || "").split("/").pop() || "";
  const pulita = sezione
    .replace(/[\u{1F000}-\u{1FAFF}\u{2190}-\u{27BF}\u{FE0F}]/gu, "")
    .replace(/\s+/g, " ")
    .trim();
  return pulita
    ? `${data.title} — lezione nella sezione ${pulita}`
    : String(data.title);
}

const pageDescription = deriveDescription(topic.data, topic.body || "");
const pageURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;

// Dati strutturati: articolo tecnico + breadcrumb dalla gerarchia del menu
const breadcrumbItems = String(topic.data.menu)
  .split("/")
  .map((nome, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: nome.trim(),
  }));
breadcrumbItems.push({
  "@type": "ListItem",
  position: breadcrumbItems.length + 1,
  name: String(topic.data.title),
  item: pageURL ? pageURL.href : undefined,
});

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: String(topic.data.title),
  description: pageDescription,
  inLanguage: "it",
  articleSection: String(topic.data.menu),
  breadcrumb: { "@type": "BreadcrumbList", itemListElement: breadcrumbItems },
};
if (topic.data.keywords) jsonLd.keywords = topic.data.keywords;

// --- 🪃 SSR underlay: contenuto statico renderizzato alla build ---
// Visibile al primo paint (sotto il loader globale, z-index 99998) e nascosto
// appena l'app Vue idrata (classe .app-hydrated su <html>, v. FlexibleLayout).
// Pipeline identica a TopicPage.vue → nessun doppione né flash al passaggio.
const underlay = (() => {
  const t = topic.data.type;

  // Markdown: stesso rendering dell'app (<div class="md">, stesse classi CSS)
  if (t === "md") {
    return `<div class="md">${renderMarkdown(resolvedBody)}</div>`;
  }

  // HTML: correggi src relativi → assoluti, wrapper <div class="page"> e
  // sanitizzazione DOMPurify default (come il ramo html di TopicPage)
  if (t === "html") {
    const corrected = (resolvedBody || "").replace(
      /src=(["'])(?!\/|https?:\/\/)([^"']*)\1/g,
      "src=$1/$2",
    );
    return sanitizePageHtml(`<div class="page">${corrected}</div>`);
  }

  // Codice: Monaco non è pre-renderizzabile, ma il testo sì:
  // un <pre> statico (resa vs-dark) dà contenuto immediato a crawler e utenti
  if (t === "code") {
    return `<pre class="ssr-pre"><code>${escapeHtml(cleanCode(resolvedBody))}</code></pre>`;
  }

  // carousel / video / chess / steps / dictionary: solo interattività
  return "";
})();

// --- 🧭 Menu statico in <noscript> ---
// Ricorsione sull'albero di buildMenuTree ({name, menu, isFolder} /
// {name, link, isFolder:false}): navigabile dai motori e dagli utenti senza JS,
// zero impatto visivo per chi ha JavaScript attivo.
interface MenuNode {
  name: string;
  link?: string;
  isFolder?: boolean;
  menu?: MenuNode[];
}
function menuHtml(nodes: MenuNode[]): string {
  if (!nodes?.length) return "";
  const items = nodes
    .map((n) =>
      n.isFolder
        ? `<li class="ssr-menu-folder"><span>${escapeHtml(n.name)}</span>${menuHtml(n.menu || [])}</li>`
        : `<li><a href="${n.link}">${escapeHtml(n.name)}</a></li>`,
    )
    .join("");
  return `<ul>${items}</ul>`;
}

const pageData = {
  type: topic.data.type,
  topic: virtualTitle || topic.data.title,
  route: virtualTitle
    ? `/topic/${topic.id}/${virtualTitle}/`
    : `/topic/${topic.id}/`,
  code: resolvedBody,
  items: resolvedItems,
  slides: resolvedSlides,
  pgn: topic.data.pgn || "",
  chessAudio,
  audio: resolvedAudio,
  autoplay: topic.data.autoplay === true,
  siblings: siblings,
  menuPath: topic.data.menu,
  currentIndex: currentIndex,
};
---

<Layout title={topic.data.title} description={pageDescription} keywords={topic.data.keywords}>
  <!-- SEO: dati strutturati (schema.org), leggibili dai crawler senza eseguire JS -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <!-- SSR underlay: contenuto statico alla build, nascosto all'idratazione -->
  {underlay && <div class="ssr-underlay" set:html={underlay} />}
  <!-- Menu navigabile senza JavaScript (crawler + progressive enhancement) -->
  <noscript><nav class="ssr-menu" aria-label="Indice del sito" set:html={menuHtml(menuTree)} /></noscript>
  <FlexibleLayout
    client:only="vue"
    initialPageData={pageData}
    initialMenuData={menuTree}
  />
</Layout>
