---
import "../styles/global.css";
import "../styles/page.css";
import "../styles/testo.css";
import "../styles/md.css";

interface Props {
  title?: string;
}

const { title = "Astro Basics" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>

    <!-- [inizio] iubenda.com  -->
    <script is:inline>
      var _iub = _iub || [];
      if (window.location.hostname !== "localhost") {
        _iub.csConfiguration = {
          cookiePolicyId: 63164304,
          siteId: 3730307,
          lang: "it",
          localConsentDomain: "note.altervista.org", // Forza il dominio preciso per evitare reset su mobile
          enableTcf: true,
          tcfVersion: 2,
          tcfPurposes: {
            "2": "consent_only",
            "3": "consent_only",
            "4": "consent_only",
            "5": "consent_only",
            "6": "consent_only",
            "7": "consent_only",
            "8": "consent_only",
            "9": "consent_only",
            "10": "consent_only",
          },
          invalidateConsentWithoutLog: false,
          googleAdditionalConsentMode: true,
          consentOnContinuedBrowsing: false,
          banner: {
            position: "top",
            acceptButtonDisplay: true,
            customizeButtonDisplay: true,
            closeButtonDisplay: true,
            closeButtonRejects: true,
            fontSizeBody: "14px",
          },
        };
      }
    </script>
    <script is:inline src="https://cdn.iubenda.com/cs/tcf/stub-v2.js"></script>
    <script is:inline async src="https://cdn.iubenda.com/cs/iubenda_cs.js"></script>
    <!-- [fine] iubenda.com  -->
  </head>

  <body>
    <!-- Overlay di caricamento globale (stato di caricamento del browser / navigazione) -->
    <div id="global-page-loader" class="global-page-loader" aria-hidden="true">
      <img src="/await.gif" alt="Caricamento..." class="global-loader-gif" />
    </div>

    <slot />

    <script is:inline>
      (function () {
        var loader = document.getElementById('global-page-loader');

        function hideLoader() {
          if (loader) {
            loader.classList.add('is-hidden');
          }
        }

        function showLoader() {
          if (loader) {
            loader.classList.remove('is-hidden');
          }
        }

        window.__showGlobalLoader = showLoader;
        window.__hideGlobalLoader = hideLoader;

        // Ripristina lo stato se la pagina viene caricata dalla bfcache (pulsante indietro/avanti)
        window.addEventListener('pageshow', function () {
          hideLoader();
        });

        // Fallback: se per qualsiasi motivo la pagina ha finito il caricamento standard, nascondi il loader
        window.addEventListener('load', function () {
          setTimeout(hideLoader, 800);
        });

        // Intercetta i click sui link interni per mostrare subito l'icona durante il caricamento del browser
        document.addEventListener('click', function (e) {
          var target = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!target) return;
          var href = target.getAttribute('href');
          if (!href) return;

          // Ignora ancore locali, protocolli speciali e target _blank
          if (
            href.startsWith('#') ||
            href.startsWith('javascript:') ||
            href.startsWith('mailto:') ||
            href.startsWith('tel:') ||
            target.target === '_blank' ||
            e.ctrlKey || e.metaKey || e.shiftKey || e.altKey
          ) {
            return;
          }

          try {
            var url = new URL(target.href, window.location.href);
            if (url.origin === window.location.origin) {
              if (
                url.pathname === window.location.pathname &&
                url.search === window.location.search &&
                url.hash !== window.location.hash
              ) {
                return;
              }
              showLoader();
            }
          } catch (err) {
            if (href.startsWith('/') && !href.startsWith('//')) {
              showLoader();
            }
          }
        }, true);

        // Mostra il loader quando il browser inizia a scaricare la nuova pagina
        window.addEventListener('beforeunload', function () {
          showLoader();
        });
      })();
    </script>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* 🌀 Overlay di caricamento globale */
  .global-page-loader {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 18, 18, 0.15);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: all;
  }

  .global-page-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .global-loader-gif {
    width: 250px;
    height: 250px;
    object-fit: contain;
  }
</style>
