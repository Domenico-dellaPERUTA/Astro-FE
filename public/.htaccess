# Header di sicurezza per il blog (deploy Apache su hosting Altervista)
# Attivi solo se mod_headers è disponibile, per evitare errori 500 altrimenti.
<IfModule mod_headers.c>
  # Previene il MIME-sniffing nei browser
  Header always set X-Content-Type-Options "nosniff"

  # Anti-clickjacking (riservandolo al client normale)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Non invia URL di provenienza completi verso risorse cross-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Forza HTTPS per 6 mesi (site is served over HTTPS)
  Header always set Strict-Transport-Security "max-age=15552000"

  # Riduce le superfici via browser features
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

  # Content-Security-Policy: origini esterne effettivamente utilizzate dal sito:
  # - iubenda (cookie consent: cdn + iframe policy/vendor-list)
  # - Google Fonts (css + font)
  # - YouTube (embed delle videolezioni)
  # - worker blob (Monaco editor) e librerie KaTeX/resource interne
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.iubenda.com https://*.iubenda.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: *; media-src 'self' data: *; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.iubenda.com; connect-src 'self' https://*.iubenda.com https://cdn.iubenda.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
